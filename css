/* ─────────────────────────────────────────────
   Sinshow 공용 레이아웃
   모든 페이지가 이 파일과 shell.js 를 불러 씁니다.
   ───────────────────────────────────────────── */

:root{
  --paper:#FFF7F5; --surface:#FFFFFF; --surface2:#FDF0EE;
  --ink:#2B1520; --muted:#8A6B74; --line:#F2DCE0;
  --accent:#C81E4E; --accent-ink:#FFFFFF; --accent-soft:#FDE6EC;
  --mark:#2D3A8C;
  --warn:#9A5B00; --warn-soft:#FBEFD9;
  --shadow:0 1px 2px rgba(80,20,40,.07);
  --rail:238px;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#1A1016; --surface:#241820; --surface2:#2E2029;
    --ink:#F2E7EA; --muted:#B79AA3; --line:#3D2A33;
    --accent:#FF6B8F; --accent-ink:#2A0B16; --accent-soft:#40202C;
    --mark:#93A3F0;
    --warn:#E0A44A; --warn-soft:#3A2A14;
    --shadow:0 1px 2px rgba(0,0,0,.45);
  }
}
:root[data-theme="dark"]{
  --paper:#1A1016; --surface:#241820; --surface2:#2E2029;
  --ink:#F2E7EA; --muted:#B79AA3; --line:#3D2A33;
  --accent:#FF6B8F; --accent-ink:#2A0B16; --accent-soft:#40202C;
  --mark:#93A3F0;
  --warn:#E0A44A; --warn-soft:#3A2A14;
  --shadow:0 1px 2px rgba(0,0,0,.45);
}

*{box-sizing:border-box}
html,body{margin:0; padding:0}
body{
  background:var(--paper); color:var(--ink);
  font-family:"Noto Sans KR", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size:15px; line-height:1.6; -webkit-font-smoothing:antialiased;
}

/* ── 사이드바 ── */
.shell-rail{
  position:fixed; inset:0 auto 0 0; width:var(--rail); z-index:40;
  background:var(--surface); border-right:1px solid var(--line);
  display:flex; flex-direction:column; overflow-y:auto;
}
.shell-brand{
  display:flex; align-items:center; gap:11px;
  padding:22px 20px 18px; text-decoration:none; color:inherit;
}
.shell-mark{
  width:30px; height:30px; border-radius:9px; flex:none;
  background:var(--accent); color:var(--accent-ink);
  display:grid; place-items:center; font-size:15px;
  font-family:"Gothic A1","Noto Sans KR",sans-serif; font-weight:900;
}
.shell-brand b{
  display:block; font-size:16px; letter-spacing:-.02em;
  font-family:"Gothic A1","Noto Sans KR",sans-serif; font-weight:900;
}
.shell-brand small{display:block; font-size:11.5px; color:var(--muted); line-height:1.3; font-weight:400}

.shell-nav{padding:6px 10px 12px; flex:1}
.shell-group{
  font-size:12px; font-weight:700; color:var(--muted);
  padding:16px 10px 6px;
}
.shell-link{
  display:flex; align-items:center; gap:10px;
  padding:9px 10px; margin-bottom:2px; border-radius:8px;
  color:var(--ink); text-decoration:none; font-size:14px; font-weight:500;
}
.shell-link:hover{background:var(--surface2)}
.shell-link[aria-current="page"]{background:var(--accent-soft); color:var(--accent); font-weight:700}
.shell-link:focus-visible{outline:2px solid var(--accent); outline-offset:2px}
.shell-link .ico{width:18px; text-align:center; font-size:13px; opacity:.7; flex:none}
.shell-link.soon{color:var(--muted); cursor:default; pointer-events:none}
.shell-link.soon::after{content:"준비중"; margin-left:auto; font-size:10.5px; opacity:.75}

.shell-foot{padding:14px 20px; border-top:1px solid var(--line); font-size:11.5px; color:var(--muted)}

/* ── 본문 ── */
.shell-content{margin-left:var(--rail); min-height:100vh}
.wrap{max-width:1080px; margin:0 auto; padding:28px 24px 80px}

/* ── 모바일 ── */
.shell-toggle{
  display:none; position:fixed; top:12px; left:12px; z-index:60;
  width:40px; height:40px; border-radius:10px; cursor:pointer;
  background:var(--surface); border:1px solid var(--line); color:var(--ink);
  font-size:17px; line-height:1; box-shadow:var(--shadow);
}
.shell-veil{display:none; position:fixed; inset:0; z-index:35; background:rgba(40,10,20,.45)}
@media (max-width:860px){
  .shell-toggle{display:block}
  .shell-rail{transform:translateX(-100%); transition:transform .18s ease}
  body.rail-open .shell-rail{transform:none}
  body.rail-open .shell-veil{display:block}
  .shell-content{margin-left:0}
  .wrap{padding:64px 16px 60px}
}
@media (prefers-reduced-motion:reduce){ *{transition:none !important} }

/* ── 홈 ── */
.home-date{font-size:13.5px; color:var(--accent); font-weight:700; margin:12px 0 6px}
.home-title{
  font-family:"Gothic A1","Noto Sans KR",sans-serif; font-weight:900;
  font-size:clamp(34px, 6vw, 52px); line-height:1.08; letter-spacing:-.035em;
  margin:0 0 10px;
}
.home-sub{color:var(--muted); font-size:14.5px; margin:0 0 34px; max-width:46ch}

.tool{
  display:flex; align-items:stretch; gap:0;
  background:var(--surface); border:1px solid var(--line);
  border-radius:14px; overflow:hidden; text-decoration:none; color:inherit;
  margin-bottom:12px;
}
.tool:hover{border-color:var(--accent)}
.tool:focus-visible{outline:2px solid var(--accent); outline-offset:3px}
.tool-bar{width:7px; flex:none; background:var(--accent)}
.tool-bar.alt{background:var(--mark)}
.tool-body{padding:24px 26px; flex:1; min-width:0}
.tool-body h2{
  font-family:"Gothic A1","Noto Sans KR",sans-serif; font-weight:900;
  font-size:21px; letter-spacing:-.02em; margin:0 0 4px;
}
.tool-body p{margin:0; color:var(--muted); font-size:14px; max-width:60ch}
.tool-go{
  display:grid; place-items:center; width:58px; flex:none;
  color:var(--muted); font-size:20px; border-left:1px solid var(--line);
}
.tool:hover .tool-go{color:var(--accent); background:var(--accent-soft)}

.tool.soon{
  background:none; border-style:dashed; pointer-events:none;
}
.tool.soon .tool-bar{background:var(--line)}
.tool.soon .tool-body h2{color:var(--muted)}
.tool.soon .tool-go{border-left-color:transparent; font-size:11.5px; font-weight:700}
